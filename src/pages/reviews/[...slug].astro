---
import Layout from '../../layouts/Layout.astro';
import EmailCTA from '../../components/EmailCTA.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', ({ data }) => !data.draft);
  return reviews.map((review) => ({
    params: { slug: review.id },
    props: { review },
  }));
}

const { review } = Astro.props;
const { Content } = await render(review);
---
<Layout title={`${review.data.title} — Spiked Adrenaline`} description={review.data.description} ogType="article">
  <article class="wrap">
    <p class="eyebrow">Field test</p>
    <h1>{review.data.title}</h1>
    <p class="muted meta">
      Published {review.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
      {review.data.updatedDate && ` · Updated ${review.data.updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}`}
    </p>
    <div class="panel verdict-box">
      <p class="eyebrow">The verdict</p>
      <p>{review.data.verdict}</p>
    </div>
    <div class="content">
      <Content />
    </div>
    <EmailCTA heading="More verdicts like this" blurb="Join the list and get every new field test the day it publishes." />
  </article>
</Layout>

<style>
  article { margin-top: 3rem; }
  h1 { font-size: clamp(1.8rem, 6vw, 2.6rem); margin: 0.5rem 0; }
  .meta { font-size: 0.9rem; }
  .verdict-box { margin: 1.5rem 0 2rem; }
  .verdict-box p:last-child { margin-bottom: 0; font-size: 1.05rem; font-weight: 600; }
  .content :global(h2) { margin-top: 2.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.4rem; }
  .content :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.1rem;
    color: var(--muted);
  }
  .content :global(table) { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .content :global(td), .content :global(th) { border: 1px solid var(--border); padding: 0.5rem 0.7rem; text-align: left; }
</style>
