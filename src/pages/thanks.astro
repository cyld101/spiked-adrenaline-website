---
import Layout from '../layouts/Layout.astro';
---
<Layout title="You're in — Spiked Adrenaline" description="Signup confirmed. Field notes and gear verdicts are on the way.">
  <section class="wrap">
    <p class="eyebrow">Confirmed</p>
    <h1>You're on the list.</h1>
    <p class="lede">
      Good call. Field tests and verdicts are headed your way — and your checklist is ready right now.
    </p>
    <a href="/checklist/" class="btn">Open the checklist</a>
    <p class="lede"><a href="/reviews/">Or read the latest reviews &rarr;</a></p>
  </section>
</Layout>

<style>
  section { margin-top: 4rem; text-align: center; }
  h1 { font-size: clamp(2rem, 7vw, 3rem); }
  .lede { color: var(--muted); max-width: 32rem; margin: 1rem auto 2rem; }
</style>
